<!doctype html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>KASUUKU V34 Admin Control</title>
<style>
:root{--orange:#ff5a00;--teal:#0d7064;--yellow:#ffbd00;--dark:#102a2a}
*{box-sizing:border-box;font-family:Arial}body{margin:0;background:#fff7e6;padding-bottom:80px}
header{background:linear-gradient(90deg,var(--orange),#ff7a2e);color:#fff;padding:14px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:10}
.view{display:none;padding:14px;max-width:520px;margin:auto}.view.active{display:block}
button{padding:12px;border:0;border-radius:12px;font-weight:900;cursor:pointer}
.primary{background:var(--orange);color:#fff;width:100%;margin-top:8px}
.field{width:100%;padding:14px;border:2px solid #ffd9a0;border-radius:12px;margin:6px 0;background:#fff;outline:0}
.card{background:#fff;border-radius:16px;padding:12px;margin:12px 0;box-shadow:0 6px 18px rgba(0,0,0,.08);border:1px solid #ffe7b8}
.heroImg{width:100%;height:280px;object-fit:cover;border-radius:20px;border:4px solid var(--yellow)}
.adminBtn{background:var(--yellow);color:#000;padding:8px 18px;border-radius:20px;font-weight:900}
.adBox{margin:12px 0;background:#fff;border:3px solid var(--teal);border-radius:14px;min-height:110px;display:flex;align-items:center;justify-content:center;overflow:hidden;position:relative}
.adTag{position:absolute;top:4px;left:6px;background:var(--yellow);font-size:9px;padding:3px 7px;border-radius:6px;font-weight:900;z-index:2}
.searchBar{width:100%;padding:15px;border:3px solid var(--orange);border-radius:14px;margin:12px 0;background:#fff}
.filterRow{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:8px 0}
.filter{width:100%;padding:12px;border:2px solid #ffd9a0;border-radius:12px;background:#fff;font-weight:700}
.listTop{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:8px 0}
.resultCount{font-weight:900;color:var(--teal)}
.houseCard{overflow:hidden;padding:0}
.houseMedia{position:relative}
.housePhoto{width:100%;height:220px;object-fit:cover;display:block}
.favBtn{position:absolute;right:10px;top:10px;width:44px;height:44px;border-radius:50%;background:#fff;color:#e33;font-size:22px;padding:0;box-shadow:0 3px 10px rgba(0,0,0,.25)}
.houseBody{padding:13px}
.housePrice{font-size:20px;color:var(--orange);font-weight:900}
.houseLoc{font-size:17px;font-weight:900;margin:5px 0}
.houseMeta{display:flex;flex-wrap:wrap;gap:5px;margin:8px 0}
.houseActions{display:grid;grid-template-columns:1fr 1fr 1fr;gap:7px;margin-top:10px}
.actionBtn{display:block;text-align:center;padding:11px 5px;border-radius:10px;text-decoration:none;font-weight:900;border:0}
.callBtn{background:var(--orange);color:#fff}
.waBtn{background:var(--teal);color:#fff}
.reportBtn{background:#ffe1e1;color:#b00000}
.emptyState{text-align:center;padding:25px;color:#666}
@media(max-width:390px){.houseActions{grid-template-columns:1fr 1fr}.reportBtn{grid-column:1/-1}}
.badge{display:inline-block;background:var(--teal);color:#fff;padding:6px 12px;border-radius:20px;font-size:11px;font-weight:800;margin:2px}
.bottomNav{position:fixed;left:0;right:0;bottom:0;height:64px;background:#fff;border-top:2px solid #ffd9a0;display:flex;justify-content:space-around;align-items:center;z-index:20;box-shadow:0 -4px 14px rgba(0,0,0,.08)}
.bottomNav button{background:transparent;color:var(--dark);padding:6px 20px;font-size:20px;display:flex;flex-direction:column;align-items:center;gap:2px}
.bottomNav span{font-size:10px;font-weight:800}
@media(min-width:700px){.bottomNav{max-width:520px;left:50%;right:auto;transform:translateX(-50%);width:520px;border-radius:18px 18px 0 0}}
</style>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>
</head><body>
<header><b>🏠 KASUUKU</b><button class="adminBtn" onclick="go('adminLogin')">ADMIN</button></header>

<div id="home" class="view active">
<img class="heroImg" src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=800&q=80">
<h2 style="text-align:center">Find rental house <span style="color:var(--orange)">without broker</span></h2>
<p style="text-align:center"><span class="badge"><b id="cnt">0</b> houses online</span> <span class="badge" style="background:var(--orange)">All Uganda</span></p>
<div id="homeAd" class="adBox" style="display:none"></div>
<div style="background:#fff;padding:14px;border-radius:12px;margin:10px 0;border-left:4px solid var(--orange)"><b style="color:var(--orange)">🏠 Welcome!</b><br><small>Direct landlord houses - <b>all Uganda</b>. No broker fee!</small></div>
<button class="primary" style="padding:18px;font-size:17px" onclick="go('list')">🔍 FIND RENTAL HOUSES</button>
<button class="primary" style="background:var(--teal);padding:18px;font-size:17px" onclick="go('login')">🏠 LIST MY HOUSE</button>
</div>

<div id="login" class="view">
<h2 style="color:var(--orange)">Landlord Login</h2>
<input id="inName" class="field" placeholder="Full Name (new only)"><input id="inPhone" class="field" placeholder="Phone e.g 0707111110"><input id="inPass" class="field" type="password" placeholder="Password min 4"><input id="inPass2" class="field" type="password" placeholder="Confirm Password (new only)"><button class="primary" style="padding:18px;background:green" onclick="doLogin()">🔓 LOGIN / CREATE</button><p id="msg" style="font-weight:900;padding:10px;text-align:center;border-radius:10px"></p>
<div class="card" style="background:#fff9c4"><h3 style="margin:0 0 6px">🔑 Forgot Password? Change It Here</h3><input id="resetPhone" class="field" placeholder="Your Phone 0707..."><input id="resetOld" class="field" type="password" placeholder="Old Password"><input id="resetNew" class="field" type="password" placeholder="New Password"><button class="primary" style="background:var(--dark)" onclick="resetLandlordPass()">CHANGE PASSWORD</button><p id="resetMsg" style="font-weight:900;text-align:center"></p></div>
<button class="primary" style="background:#999" onclick="go('home')">Home</button>
</div>

<div id="list" class="view">
<h2>🔥 Rental Houses - All Uganda</h2>
<div id="listAd" class="adBox" style="display:none"></div>
<input id="qSearch" class="searchBar" placeholder="🔍 Search location, description, landlord..." oninput="render()">
<div class="filterRow">
<select id="typeFilter" class="filter" onchange="render()">
<option value="">🏠 All house types</option>
<option>Single Room</option><option>Self Contained</option><option>1 Bedroom</option>
<option>2 Bedroom</option><option>3 Bedroom</option><option>House</option><option>Shop</option>
</select>
<select id="priceFilter" class="filter" onchange="render()">
<option value="">💰 Any price</option>
<option value="0-200000">Up to 200K</option><option value="200000-400000">200K–400K</option>
<option value="400000-700000">400K–700K</option><option value="700000-999999999">700K+</option>
</select>
</div>
<div class="listTop">
<span id="resultCount" class="resultCount">Loading...</span>
<select id="sortFilter" class="filter" style="width:auto" onchange="render()">
<option value="new">Newest</option><option value="low">Cheapest</option><option value="high">Most expensive</option>
</select>
</div>
<div id="listBox">Loading...</div>
<button class="primary" style="background:#999" onclick="go('home')">Home</button>
</div>

<div id="add" class="view">
<div id="dashAd" class="adBox" style="display:none"></div><h2 style="color:var(--teal)">My Dashboard</h2><b id="who" style="background:var(--yellow);padding:10px;border-radius:10px;display:block;text-align:center"></b>
<h3>Add House - Anywhere in Uganda</h3><input id="fPrice" class="field" type="number" placeholder="Price UGX"><select id="fType" class="field"><option value="">House type</option><option>Single Room</option><option>Self Contained</option><option>1 Bedroom</option><option>2 Bedroom</option><option>3 Bedroom</option><option>House</option><option>Shop</option></select><input id="fLoc" class="field" placeholder="Location e.g Gulu, Mbarara, Kampala..."><textarea id="fDesc" class="field" placeholder="Description" rows="3"></textarea><input id="pick" type="file" accept="image/*" class="field"><img id="prv" style="width:100%;display:none;border-radius:16px;margin-top:8px"><button class="primary" onclick="doPublish()">🚀 PUBLISH</button>
<h3>My Houses (Can Delete)</h3><div id="myHousesBox"></div>
<div class="card" style="border:3px solid var(--teal)"><h3>🔑 Change My Login Password</h3><input id="oldPass" class="field" type="password" placeholder="Old Password"><input id="newPass" class="field" type="password" placeholder="New Password"><button class="primary" style="background:var(--teal)" onclick="changeLandlordPass()">UPDATE PASSWORD</button></div>
<button class="primary" style="background:#999" onclick="logout()">Logout</button>
</div>

<div id="adminLogin" class="view"><h2>Admin Login</h2><input id="aPhone" class="field" placeholder="admin"><input id="aPass" class="field" type="password" placeholder="Password"><button class="primary" onclick="doAdminLogin()">ENTER</button><p id="aMsg" style="color:red"></p><button class="primary" style="background:#999" onclick="go('home')">Home</button></div>

<div id="admin" class="view"><h2>Admin Panel</h2>
<div class="card" style="border:3px solid var(--orange)"><h3>💰 Add Ad - PHOTO OR VIDEO</h3><input id="adTitle" class="field" placeholder="Business Name"><input id="adLink" class="field" placeholder="WhatsApp Link"><div style="display:flex;gap:8px"><button onclick="adPickPhoto.click()" style="flex:1;background:var(--teal);color:#fff;padding:12px;border-radius:10px">📸 PHOTO</button><button onclick="adPickVideo.click()" style="flex:1;background:red;color:#fff;padding:12px;border-radius:10px">🎥 VIDEO</button></div><input id="adPickPhoto" type="file" accept="image/*" style="display:none"><input id="adPickVideo" type="file" accept="video/*" style="display:none"><div id="adPreviewArea" style="display:none;margin-top:10px"><img id="adPrv" style="width:100%;display:none;border-radius:12px"><video id="adPrvV" style="width:100%;display:none;border-radius:12px" controls muted playsinline></video><p id="adTypeLabel" style="text-align:center;font-weight:900"></p></div><button class="primary" style="background:var(--yellow);color:#000" onclick="addBizAd()">SAVE AD</button></div>

<div class="card"><h3>🔑 Change Admin Password</h3><p>ID: <b id="curAdminId"></b></p><input id="adminOld" class="field" type="password" placeholder="Old Password"><input id="adminNew" class="field" type="password" placeholder="New Password"><button class="primary" style="background:var(--dark)" onclick="changeAdminPass()">UPDATE ADMIN PASSWORD</button></div>

<p id="adminInfo" style="background:#fff;padding:12px;border-radius:12px;text-align:center;border:2px solid var(--teal)"></p>

<h3>📢 Active Ads</h3><div id="bizBox"></div>

<div class="card" style="background:#ffe7e7;border:2px solid red"><h3>🏠 Admin - Remove Houses + Search</h3>
<input id="adminSearch" class="searchBar" style="border-color:red" placeholder="🔍 Search houses to delete..." oninput="renderAdminHouses()">
<div id="adminBox"></div>
</div>

<button class="primary" style="background:#222" onclick="go('home')">LOGOUT</button></div>

<script>
// YOUR FIREBASE
const firebaseConfig={apiKey:"AIzaSyC_ynlX8ovNXfucAnQjvQ4NwPQJKRv0nDk",authDomain:"kasuuku-765cf.firebaseapp.com",databaseURL:"https://kasuuku-765cf-default-rtdb.firebaseio.com",projectId:"kasuuku-765cf",storageBucket:"kasuuku-765cf.firebasestorage.app",messagingSenderId:"807864374101",appId:"1:807864374101:web:bc715edd1c64379875d5dc"};
firebase.initializeApp(firebaseConfig);const db=firebase.database();

let houses=[],bizAds=[],cur=null,adIdx=0,adData=null,adIsVideo=false,curAdmin=null;
try{cur=JSON.parse(localStorage.getItem('k_c')||'null')}catch(e){}
function go(id){document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));document.getElementById(id).classList.add('active');if(id==='add'&&cur)who.innerText="Logged: "+cur.name+" ("+cur.phone+")";render();}
function getUsers(){try{return JSON.parse(localStorage.getItem('k_u')||'{}');}catch(e){return {};}}
function getAdmins(){let d={};try{d=JSON.parse(localStorage.getItem('k_admins')||'{}')}catch(e){};if(!d['admin'])d['admin']={pass:'admin123'};if(!d['0707111110'])d['0707111110']={pass:'kS1@2024'};return d;}

function doLogin(){let n=inName.value.trim(),p=inPhone.value.trim().replace(/\D/g,''),pw=inPass.value.trim(),pw2=inPass2.value.trim(),m=msg;if(p.length<7){m.style.background='#ffcccc';m.innerText='Phone too short';return;}if(pw.length<4){m.style.background='#ffcccc';m.innerText='Pass min 4';return;}let u=getUsers();if(u[p]){if(u[p].pass!==pw){m.style.background='#ffcccc';m.innerText='Wrong password! Use change password below';return;}cur=u[p];localStorage.setItem('k_c',JSON.stringify(cur));m.style.background='#ccffcc';m.innerText='Welcome '+cur.name;setTimeout(()=>go('add'),600);}else{if(n.length<2){m.style.background='#ffcccc';m.innerText='Enter name';return;}if(pw!==pw2){m.style.background='#ffcccc';m.innerText='Passwords not match';return;}u[p]={name:n,phone:p,pass:pw};localStorage.setItem('k_u',JSON.stringify(u));cur=u[p];localStorage.setItem('k_c',JSON.stringify(cur));m.style.background='#ccffcc';m.innerText='Account created!';setTimeout(()=>go('add'),600);}}

function resetLandlordPass(){let p=resetPhone.value.trim().replace(/\D/g,''),o=resetOld.value.trim(),n=resetNew.value.trim(),m=resetMsg;if(!p||!o||!n){m.style.color='red';m.innerText='Fill all fields';return;}let u=getUsers();if(!u[p]){m.style.color='red';m.innerText='Phone not found';return;}if(u[p].pass!==o){m.style.color='red';m.innerText='Old password wrong';return;}if(n.length<4){m.style.color='red';m.innerText='New min 4 chars';return;}u[p].pass=n;localStorage.setItem('k_u',JSON.stringify(u));m.style.color='green';m.innerText='✅ Password changed! Now login with new password';resetOld.value='';resetNew.value='';}

function doAdminLogin(){let p=aPhone.value.trim().toLowerCase(),w=aPass.value.trim(),admins=getAdmins();if(admins[p]&&admins[p].pass===w){curAdmin=p;curAdminId.innerText=p;aMsg.innerText='';go('admin');}else{aMsg.innerText='Wrong';}}
function changeAdminPass(){let o=adminOld.value.trim(),n=adminNew.value.trim(),admins=getAdmins();if(!curAdmin)return;if(admins[curAdmin].pass!==o){alert('Old wrong');return;}if(n.length<4){alert('New min 4');return;}admins[curAdmin].pass=n;localStorage.setItem('k_admins',JSON.stringify(admins));alert('Admin password changed to: '+n);adminOld.value='';adminNew.value='';}
function changeLandlordPass(){if(!cur)return;let o=oldPass.value.trim(),n=newPass.value.trim(),u=getUsers();if(u[cur.phone].pass!==o){alert('Old wrong');return;}if(n.length<4){alert('New min 4');return;}u[cur.phone].pass=n;localStorage.setItem('k_u',JSON.stringify(u));cur.pass=n;localStorage.setItem('k_c',JSON.stringify(cur));alert('✅ Your login password changed!');oldPass.value='';newPass.value='';}
function logout(){localStorage.removeItem('k_c');cur=null;go('home');}

function renderAdminHouses(){
let q=(document.getElementById('adminSearch')?.value||'').toLowerCase();
let filtered=houses.filter(x=>!q||x.loc.toLowerCase().includes(q)||String(x.price).includes(q)||String(x.ph).includes(q)||String(x.desc||'').toLowerCase().includes(q)||String(x.nm||'').toLowerCase().includes(q)||String(x.type||'').toLowerCase().includes(q));
document.getElementById('adminBox').innerHTML=filtered.length?filtered.map(x=>`<div class="card" style="display:flex;gap:10px;align-items:center;border-left:4px solid red"><img src="${x.photo}" style="width:60px;height:60px;border-radius:10px;object-fit:cover"><div style="flex:1"><b>${x.loc}</b><br><small>${x.price} UGX | ${x.ph} | ${x.nm}</small><br><small style="color:#666">${x.desc||''}</small></div><button onclick="if(confirm('Delete this house?\\n${x.loc}'))db.ref('houses/${x.id}').remove()" style="background:red;color:#fff;padding:10px 14px;border-radius:10px;font-weight:900">DELETE</button></div>`).join(''):'<div class="card">No houses found for search</div>';
}

function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function priceNum(v){return Number(String(v||'').replace(/[^\d.]/g,''))||0;}
function waNumber(ph){let p=String(ph||'').replace(/\D/g,'');if(p.startsWith('0'))p='256'+p.slice(1);if(!p.startsWith('256'))p='256'+p;return p;}
function toggleFav(id){let f=[];try{f=JSON.parse(localStorage.getItem('k_favs')||'[]')}catch(e){};f.includes(id)?f=f.filter(x=>x!==id):f.push(id);localStorage.setItem('k_favs',JSON.stringify(f));render();}
function reportHouse(id){let h=houses.find(x=>x.id===id);if(!h)return;let reason=prompt('Why are you reporting this listing? (optional)');if(reason===null)return;let rid=Date.now().toString();db.ref('reports/'+rid).set({id:rid,houseId:id,location:h.loc||'',phone:h.ph||'',reason:reason||'Reported by user',date:Date.now()}).then(()=>alert('Thank you. The listing has been reported to KASUUKU admin.')).catch(()=>alert('Could not send report. Check your connection.'));}
function openLocation(loc){let u='https://www.google.com/maps/search/?api=1&query='+encodeURIComponent(loc||'Uganda');window.open(u,'_blank');}

function render(){
  try{cnt.innerText=houses.length}catch(e){}
  let q=(document.getElementById('qSearch')?.value||'').toLowerCase().trim();
  let type=(document.getElementById('typeFilter')?.value||'').toLowerCase();
  let pf=document.getElementById('priceFilter')?.value||'';
  let sort=document.getElementById('sortFilter')?.value||'new';
  let filtered=houses.filter(x=>{
    let text=[x.loc,x.desc,x.nm,x.ph,x.type].join(' ').toLowerCase();
    if(q && !text.includes(q))return false;
    if(type && String(x.type||'').toLowerCase()!==type)return false;
    if(pf){let [lo,hi]=pf.split('-').map(Number),p=priceNum(x.price);if(p<lo||p>hi)return false;}
    return true;
  });
  if(sort==='low')filtered.sort((a,b)=>priceNum(a.price)-priceNum(b.price));
  if(sort==='high')filtered.sort((a,b)=>priceNum(b.price)-priceNum(a.price));
  if(sort==='new')filtered.sort((a,b)=>(Number(b.id)||0)-(Number(a.id)||0));

  let rc=document.getElementById('resultCount');if(rc)rc.innerText=filtered.length+' house'+(filtered.length===1?'':'s')+' found';
  let favs=[];try{favs=JSON.parse(localStorage.getItem('k_favs')||'[]')}catch(e){}
  let box=document.getElementById('listBox');
  if(box)box.innerHTML=filtered.length?filtered.map(x=>{
    let isFav=favs.includes(x.id), w='https://wa.me/'+waNumber(x.ph)+'?text='+encodeURIComponent('Hello, I found your KASUUKU house in '+(x.loc||'Uganda')+'. Is it still available?');
    let tel='tel:+'+waNumber(x.ph);
    let typeBadge=x.type?'<span class="badge">'+esc(x.type)+'</span>':'';
    return `<div class="card houseCard">
      <div class="houseMedia"><img class="housePhoto" src="${esc(x.photo)}" alt="Rental house in ${esc(x.loc)}" loading="lazy">
      <button class="favBtn" onclick="toggleFav('${esc(x.id)}')" title="Save house">${isFav?'♥':'♡'}</button></div>
      <div class="houseBody">
        <div class="housePrice">UGX ${esc(Number(x.price)||x.price)}</div>
        <div class="houseLoc">📍 ${esc(x.loc)}</div>
        <div class="houseMeta">${typeBadge}<span class="badge" style="background:var(--orange)">Direct landlord</span></div>
        <div><small>${esc(x.desc||'No description provided')}</small></div>
        <small style="display:block;margin-top:8px;color:#777">👤 ${esc(x.nm||'Landlord')} • Posted ${x.id?new Date(Number(x.id)).toLocaleDateString():''}</small>
        <div class="houseActions">
          <a class="actionBtn callBtn" href="${tel}">📞 Call</a>
          <a class="actionBtn waBtn" href="${w}" target="_blank">💬 WhatsApp</a>
          <button class="actionBtn reportBtn" onclick="reportHouse('${esc(x.id)}')">🚨 Report</>
